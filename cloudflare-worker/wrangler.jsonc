{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spokenmed",
  "main": "src/index.js",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "browser": { "binding": "BROWSER" },
  "durable_objects": {
    "bindings": [
      { "name": "FIORILLI_DO", "class_name": "FiorilliDO" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["FiorilliDO"] }
  ]
}
